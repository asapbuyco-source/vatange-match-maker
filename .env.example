# ============================================================
# VANTAGE MATCH — Environment Variables Template
# Commit this file to Git (no real values inside).
# Copy to .env and fill in your real credentials.
# ============================================================

VITE_APP_NAME=Vantage Match
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development
VITE_DEFAULT_LANGUAGE=en

# ---- Gemini AI ----
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# ---- Firebase ----
# https://console.firebase.google.com → vantage-match → Project Settings → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ---- Fapshi (Payment — Cameroon) ----
# https://dashboard.fapshi.com → Create Collection Service
VITE_FAPSHI_API_USER=
VITE_FAPSHI_API_KEY=
VITE_FAPSHI_ENV=sandbox

# ---- Cloudinary ----
# https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=vantage_profile_photos
VITE_CLOUDINARY_API_KEY=

# ---- Sentry (Error Monitoring) ----
# https://sentry.io
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
